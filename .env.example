# Supabase project URL: Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=
# Supabase publishable (anon) key: Dashboard > Project Settings > API Keys
# This key is safe for the browser ONLY because Row Level Security is enabled.
# NEVER put the service_role / secret key in any VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
